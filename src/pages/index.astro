---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import Footer from "@/components/Footer.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import WorkCard from "@/components/WorkCard.astro";
import { socialLinks } from "@/data/social";
import { getCollection } from "astro:content";

const [publishedWorks, publishedArticles] = await Promise.all([
  getCollection("vibe-coding", (work) => !work.data.draft),
  getCollection("writing", (article) => !article.data.draft),
]);

const featuredWorks = ([
  ["wukong", "悟空"],
  ["ai-pm-workbench", "AI PM Workbench", "/images/vibe-coding/ai-pm-workbench/logo.webp"],
  ["ai-employee-os", "AI Employee OS", "/images/vibe-coding/ai-employee-os/logo.webp"],
  ["claude-cream", "Claude Cream", "/images/vibe-coding/claude-cream/logo.png"],
  ["obsidian-wiki", "Obsidian Wiki"],
] as const).flatMap(([id, title, icon]) => {
  const work = publishedWorks.find((entry) => entry.id === id);
  return work ? [{ work, title, icon }] : [];
});
const recentArticles = publishedArticles
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 11);
const github = socialLinks.find(({ id }) => id === "github");
const email = socialLinks.find(({ id }) => id === "email");
---

<BaseLayout
  title="Kakarrot"
  description="AI 产品经理 — 从第一性原理拆解复杂业务，用 AI 原生方式做成可落地的产品系统。"
  canonical="/"
  navigation={false}
>
  <div class="shell home-page">
    <section aria-labelledby="home-introduction">
      <h1 class="home-title" id="home-introduction">
        <img class="home-avatar border-overlay" src="/avatar.png" alt="" width="24" height="24" decoding="async" />
        <span>Kakarrot</span>
      </h1>
      <div class="home-bio">
        <p>
          我在郑州做 AI 产品，有 <strong>10 年以上的产品经理经验</strong>。做过互联网、To B、To C 和 To G 产品，覆盖 Web、移动端和桌面端。我熟悉从 0 到 1 的创业，也做过上线后的持续迭代。
        </p>
        <p>
          我擅长从第一性原理拆解业务问题，用 AI 原生方式重新设计产品与增长系统。最近也在整理自己的工作流，试着把 AI 和产品直觉结合起来，让开发和协作更顺畅。
          {github && email && (
            <>
              可以在 <a href={github.href} class="inline-icon-link interactive" target="_blank" rel="noopener noreferrer">
                <SocialIcon id={github.id} class="inline-glyph" />GitHub<span class="sr-only">（在新标签页打开）</span>
              </a> 看我的项目，或<a href={email.href} class="inline-icon-link interactive">
                <svg class="inline-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.5 5h15A2.5 2.5 0 0 1 22 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 16.5v-9A2.5 2.5 0 0 1 4.5 5Zm.08 3.33a.9.9 0 0 0 .25 1.25l6.68 4.45a.9.9 0 0 0 1 0l6.66-4.45a.9.9 0 1 0-1-1.5L12 12.2 5.83 8.08a.9.9 0 0 0-1.25.25Z" />
                </svg>发邮件
              </a>联系我。
            </>
          )}
          也可以看看<a href="/about/" class="inline-icon-link interactive">
            <svg class="inline-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.76 0-8.5 2.47-8.5 5.5v.75c0 .41.34.75.75.75h15.5c.41 0 .75-.34.75-.75v-.75c0-3.03-3.74-5.5-8.5-5.5Z" />
            </svg>我的经历与做事原则
          </a>。
          <button
            type="button"
            class="inline-search interactive"
            data-site-search-open
            aria-haspopup="dialog"
            aria-controls="site-search"
            aria-keyshortcuts="Meta+K Control+K"
          >
            <span class="inline-keycaps" aria-hidden="true" title="Ctrl + K">
              <kbd class="inline-kbd" data-site-search-modifier>⌃</kbd>
              <kbd class="inline-kbd">K</kbd>
            </span><svg class="inline-glyph inline-search-touch-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10.5 3a7.5 7.5 0 1 0 4.56 13.45l4.36 4.37a1.25 1.25 0 0 0 1.77-1.77l-4.37-4.36A7.5 7.5 0 0 0 10.5 3Zm0 2.5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" />
            </svg>搜索
          </button>
        </p>
      </div>
      <nav class="home-archives" aria-label="归档">
        <a href="/writing/" class="section-link article-underline interactive">全部文章</a>
        <a href="/vibe-coding/" class="section-link article-underline interactive">全部作品</a>
      </nav>
    </section>

    <section aria-labelledby="home-work">
      <h2 class="home-section-heading section-heading" id="home-work">
        <a href="/vibe-coding/" class="interactive">Vibe Coding</a>
      </h2>
      <ul class="home-list" role="list">
        {
          featuredWorks.map(({ work, title, icon }) => (
            <li>
              <WorkCard
                title={title}
                summary={work.data.summary ?? work.data.description}
                href={`/vibe-coding/${work.id}/`}
                cover={work.data.cover}
                icon={icon}
                date={work.data.publishedAt}
                compact
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="home-writing">
      <h2 class="home-section-heading section-heading" id="home-writing">
        <a href="/writing/" class="interactive">Writing</a>
      </h2>
      <ul class="home-list" role="list">
        {
          recentArticles.map((article) => (
            <li>
              <ArticleRow
                title={article.data.title}
                href={`/writing/${article.id}/`}
                date={article.data.publishedAt}
                compact
              />
            </li>
          ))
        }
      </ul>
    </section>

    <Footer home />
  </div>
</BaseLayout>

<style>
  .home-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--section-gap);
  }

  .home-title {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    margin: 0 0 16px;
    color: var(--color-gray-1200);
    font-size: var(--text-body);
    font-weight: var(--weight-home-heading);
  }

  .home-avatar {
    flex: none;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .home-bio {
    color: var(--color-gray-1100);
    font-weight: 400;
  }

  .home-bio strong {
    font-weight: var(--weight-home-heading);
  }

  .home-bio p {
    margin: 0;
    text-wrap: pretty;
  }

  .home-bio p + p {
    margin-block-start: 16px;
  }

  .home-archives {
    display: flex;
    flex-wrap: wrap;
    column-gap: 16px;
    margin-block-start: 8px;
  }

  .home-archives a {
    text-decoration-color: var(--color-gray-1100);
  }

  .inline-icon-link, .inline-search {
    color: var(--color-gray-1200);
    font-weight: var(--weight-link);
    white-space: nowrap;
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .inline-search {
    display: inline;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: var(--text-body);
    line-height: 20px;
    cursor: pointer;
  }

  .home-bio :global(.inline-glyph) {
    display: inline-block;
    inline-size: 16px;
    block-size: 16px;
    margin-inline-end: 4px;
    margin-block-end: 2px;
    vertical-align: middle;
  }

  .inline-keycaps {
    display: none;
    align-items: center;
    gap: 4px;
    margin-inline-end: 4px;
    vertical-align: middle;
  }

  .inline-kbd {
    display: inline-flex;
    flex: none;
    inline-size: 18px;
    block-size: 18px;
    align-items: center;
    justify-content: center;
    user-select: none;
    border: 1px solid var(--color-preview-bg);
    border-radius: 5px;
    background-color: var(--color-gray-200);
    background-clip: padding-box;
    color: var(--color-gray-1100);
    font: var(--weight-link) var(--text-xs)/1 var(--font-sans);
    box-shadow: var(--shadow-custom), inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    transition-property: color, background-color, border-color, box-shadow, scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
  }

  :global(.dark) .inline-kbd {
    box-shadow: var(--shadow-custom), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  @media (hover: hover) and (pointer: fine) {
    :is(.inline-icon-link, .inline-search):hover {
      text-decoration-color: var(--color-gray-1100);
    }
  }

  @media (pointer: fine) {
    .inline-keycaps {
      display: inline-flex;
    }

    .home-bio .inline-search-touch-icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inline-kbd {
      transition: none;
    }
  }

  .home-section-heading {
    margin: 0 0 12px;
    font-weight: var(--weight-home-heading);
  }

  .home-section-heading a {
    color: inherit;
    text-decoration: underline transparent;
  }

  .home-section-heading a:is(:hover, :focus-visible) {
    text-decoration-color: var(--color-gray-1100);
  }

</style>
