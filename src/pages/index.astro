---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import WorkCard from "@/components/WorkCard.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { socialLinks } from "@/data/social";
import { getCollection } from "astro:content";

const [publishedWorks, publishedArticles] = await Promise.all([
  getCollection("vibe-coding", (work) => !work.data.draft),
  getCollection("writing", (article) => !article.data.draft),
]);

const featuredWorks = ([
  ["wukong", "悟空"],
  ["ai-pm-workbench", "AI PM Workbench", "/images/vibe-coding/ai-pm-workbench/logo.webp"],
  ["ai-employee-os", "AI Employee OS", "/images/vibe-coding/ai-employee-os/logo.webp"],
  ["claude-cream", "Claude Cream"],
  ["obsidian-wiki", "Obsidian Wiki"],
] as const).flatMap(([id, title, icon]) => {
  const work = publishedWorks.find((entry) => entry.id === id);
  return work ? [{ work, title, icon }] : [];
});
const recentArticles = publishedArticles
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 11);
const github = socialLinks.find(({ id }) => id === "github");
const email = socialLinks.find(({ id }) => id === "email");
---

<BaseLayout
  title="Kakarrot"
  description="AI 产品经理 — 从第一性原理拆解复杂业务，用 AI 原生方式做成可落地的产品系统。"
  canonical="/"
  navigation={false}
>
  <div class="container home-page">
    <section aria-labelledby="home-introduction">
      <header class="home-identity">
        <img src="/avatar.png" alt="" width="24" height="24" decoding="async" />
        <h1 id="home-introduction">Kakarrot</h1>
        <ThemeToggle />
      </header>
      <div class="home-bio">
        <p>
          我在郑州做 AI 产品，有 <strong>10 年以上的产品经理经验</strong>。做过互联网、To B、To C 和 To G 产品，覆盖 Web、移动端和桌面端。我熟悉从 0 到 1 的创业，也做过上线后的持续迭代。
        </p>
        <p>
          我擅长从第一性原理拆解业务问题，用 AI 原生方式重新设计产品与增长系统。最近也在整理自己的工作流，试着把 AI 和产品直觉结合起来，让开发和协作更顺畅。
          {github && email && (
            <>可以在 <a href={github.href} target="_blank" rel="noopener noreferrer"><SocialIcon id={github.id} />GitHub</a> 看我的项目，或<a href={email.href}><SocialIcon id={email.id} />发邮件</a>联系我。</>
          )}
          也可以看看<a href="/about/">我的经历与做事原则</a>。
          <button
            type="button"
            class="home-search"
            data-site-search-open
            aria-haspopup="dialog"
            aria-controls="site-search"
            aria-keyshortcuts="Control+K Meta+K"
          >
            搜索 <kbd data-site-search-shortcut aria-hidden="true">Ctrl K</kbd>
          </button>
        </p>
      </div>
    </section>

    <section aria-labelledby="home-work">
      <header class="home-section-header">
        <h2 id="home-work"><a href="/vibe-coding/">Projects</a></h2>
      </header>
      <ul class="home-list" role="list">
        {
          featuredWorks.map(({ work, title, icon }) => (
            <li>
              <WorkCard
                title={title}
                summary={work.data.summary ?? work.data.description}
                href={`/vibe-coding/${work.id}/`}
                cover={work.data.cover}
                icon={icon}
                date={work.data.publishedAt}
                compact
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="home-writing">
      <header class="home-section-header">
        <h2 id="home-writing"><a href="/writing/">Writing</a></h2>
      </header>
      <ul class="home-list" role="list">
        {
          recentArticles.map((article) => (
            <li>
              <ArticleRow
                title={article.data.title}
                href={`/writing/${article.id}/`}
                date={article.data.publishedAt}
                compact
              />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    display: grid;
    gap: 92px;
    padding-block: 108px 88px;
  }

  .home-identity {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .home-identity img {
    flex: none;
    border-radius: 50%;
    object-fit: cover;
  }

  .home-identity h1 {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .home-bio {
    color: var(--color-muted);
    line-height: 1.75;
  }

  .home-bio strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .home-bio p {
    margin: 0;
    text-wrap: pretty;
  }

  .home-bio p + p {
    margin-top: 12px;
  }

  .home-identity > :global(.theme-toggle) {
    flex: none;
    margin-inline: auto -6px;
  }

  .home-bio a,
  .home-search {
    text-decoration: underline var(--color-hairline);
    text-underline-offset: 3px;
  }

  .home-bio a {
    white-space: nowrap;
  }

  .home-bio a :global(svg) {
    display: inline-block;
    width: 0.82em;
    height: 0.82em;
    margin-inline-end: 0.26em;
    vertical-align: -0.08em;
  }

  .home-bio a:is(:hover, :focus-visible),
  .home-search:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  .home-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: var(--nav-h);
    min-height: var(--nav-h);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
  }

  .home-search kbd {
    display: none;
    padding: 0 4px;
    border: var(--line-hairline);
    border-radius: 3px;
    color: var(--color-muted);
    font: 400 11px/1.5 var(--font-mono);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-search kbd {
      display: inline-block;
    }
  }

  .home-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--nav-h);
  }

  .home-section-header::after {
    flex: 1;
    border-top: var(--line-hairline);
    content: "";
  }

  .home-section-header h2 {
    margin: 0;
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.4;
  }

  .home-section-header a {
    display: inline-flex;
    align-items: center;
    min-height: var(--nav-h);
    color: inherit;
    text-decoration: underline transparent;
  }

  .home-section-header a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  .home-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-list li + li {
    border-top: var(--line-divider);
  }

  @media (max-width: 640px) {
    .home-page {
      gap: 58px;
      padding-block: 60px;
    }
  }
</style>
