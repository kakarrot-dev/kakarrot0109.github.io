---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("writing"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const tagCounts = new Map<string, number>();
for (const { data } of articles) {
  for (const tag of new Set(data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const rankedTags = [...tagCounts]
  .sort(([a, aCount], [b, bCount]) => bCount - aCount || a.localeCompare(b, "zh-CN"));
const popularTags = rankedTags.slice(0, 6).map(([tag]) => tag);
const moreTags = rankedTags.slice(6).map(([tag]) => tag)
  .sort((a, b) => a.localeCompare(b, "zh-CN"));

const years = new Map<number, typeof articles>();
for (const article of articles) {
  const year = article.data.publishedAt.getUTCFullYear();
  const group = years.get(year);
  if (group) group.push(article);
  else years.set(year, [article]);
}
---

<BaseLayout
  title="Writing"
  description="关于 AI 产品、方法论与实践的笔记与长文"
  canonical="/writing/"
>
  <div class="shell">
    <header class="editorial-header">
      <h1 class="editorial-title">Writing</h1>
      <div class="editorial-header__details">
        <p class="editorial-lead">关于 AI 产品、方法论与实践的笔记与长文</p>
        <p class="editorial-count">{articles.length} articles</p>
      </div>
      {popularTags.length > 0 && (
        <div class="writing-tags">
          <ul role="list" aria-label="常用文章标签">
            {popularTags.map((tag) => (
              <li><a class="article-underline interactive" href={`/writing/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
            ))}
          </ul>
          {moreTags.length > 0 && (
            <details>
              <summary class="interactive pressable">更多标签</summary>
              <ul role="list" aria-label="更多文章标签">
                {moreTags.map((tag) => (
                  <li><a class="article-underline interactive" href={`/writing/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
                ))}
              </ul>
            </details>
          )}
        </div>
      )}
    </header>

    {
      [...years].map(([year, entries]) => (
        <section class="writing-year">
          <h2>{year}</h2>
          <ul class="index-list" role="list">
            {entries.map((article) => (
              <li>
                <ArticleRow
                  title={article.data.title}
                  href={`/writing/${article.id}/`}
                  date={article.data.publishedAt}
                  groupedByYear
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .writing-tags {
    margin-block-start: 8px;
  }

  .writing-tags summary {
    width: fit-content;
    min-height: var(--nav-h);
    align-content: center;
    color: var(--color-gray-1100);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .writing-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing-tags details ul {
    padding-block-start: 8px;
    border-block-start: var(--line-divider);
  }

  .writing-tags a {
    display: inline-flex;
    align-items: center;
    min-height: var(--nav-h);
    color: var(--color-gray-1100);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .writing-tags summary:is(:hover, :focus-visible) {
    color: var(--color-gray-1200);
  }

  .writing-year + .writing-year {
    margin-top: 56px;
  }

  .writing-year h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 12px;
    color: var(--color-gray-1100);
    font: 400 var(--text-meta)/1.6 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .writing-year h2::after {
    flex: 1;
    border-top: var(--line-hairline);
    content: "";
  }
</style>
