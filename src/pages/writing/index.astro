---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("writing"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const tags = [...new Set(articles.flatMap(({ data }) => data.tags))]
  .sort((a, b) => a.localeCompare(b, "zh-CN"));

const years = new Map<number, typeof articles>();
for (const article of articles) {
  const year = article.data.publishedAt.getUTCFullYear();
  const group = years.get(year);
  if (group) group.push(article);
  else years.set(year, [article]);
}
---

<BaseLayout
  title="Writing"
  description="关于 AI 产品、方法论与实践的笔记与长文"
  canonical="/writing/"
>
  <div class="container section page-shell editorial-page">
    <header class="editorial-header">
      <h1 class="editorial-title">Writing</h1>
      <div class="editorial-header__details">
        <p class="editorial-lead">关于 AI 产品、方法论与实践的笔记与长文</p>
        <p class="editorial-count">{articles.length} articles</p>
      </div>
      {tags.length > 0 && (
        <details class="writing-tags">
          <summary>标签</summary>
          <ul role="list" aria-label="文章标签">
            {tags.map((tag) => (
              <li><a href={`/writing/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
            ))}
          </ul>
        </details>
      )}
    </header>

    {
      [...years].map(([year, entries]) => (
        <section class="writing-year">
          <h2>{year}</h2>
          <ul class="article-list" role="list">
            {entries.map((article) => (
              <li>
                <ArticleRow
                  title={article.data.title}
                  href={`/writing/${article.id}/`}
                  date={article.data.publishedAt}
                  groupedByYear
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .writing-tags {
    margin-block-start: 8px;
  }

  .writing-tags summary {
    width: fit-content;
    min-height: var(--nav-h);
    align-content: center;
    color: var(--color-muted);
    font-size: var(--text-small);
    cursor: pointer;
  }

  .writing-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    margin: 0;
    padding: 8px 0 0;
    border-top: var(--line-divider);
    list-style: none;
  }

  .writing-tags a {
    display: inline-flex;
    align-items: center;
    min-height: var(--nav-h);
    color: var(--color-muted);
    font-size: var(--text-small);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    overflow-wrap: anywhere;
  }

  .writing-tags :is(summary, a):is(:hover, :focus-visible) {
    color: var(--color-ink);
  }

  .writing-year + .writing-year {
    margin-top: 56px;
  }

  .writing-year h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 12px;
    color: var(--color-muted);
    font: 400 var(--text-meta)/1.6 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .writing-year h2::after {
    flex: 1;
    border-top: var(--line-hairline);
    content: "";
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-list li + li {
    border-top: var(--line-divider);
  }
</style>
