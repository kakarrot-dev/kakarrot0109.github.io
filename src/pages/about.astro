---
import BaseLayout from "@/layouts/BaseLayout.astro";

const deskDesktop = [
  ["CPU", "Intel i5-13600kf"],
  ["主板", "Asus TUF B760M-PLUS WIFI II"],
  ["显卡", "Asus TUF RTX 4070 SUPER O12G"],
  ["内存", "Corsair 16G×2 DDR5 6400"],
  ["固态", "Samsung 980PRO 1T + TiPlus7100 2TB"],
  ["散热", "DeepCool AK620"],
  ["电源", "Phanteks AMP GH850W"],
  ["机箱", "NZXT S340 Elite"],
  ["解码", "OCTAVART Champs-élysées + HD650"],
  ["音箱", "Bose C50"],
  ["键盘", "Filco 圣手二代 104 / Cherry G80-3000"],
  ["鼠标", "Logitech G903 + Master 3"],
  ["显示", "LG 34UC88-B + LG 27GR84Q-B"],
  ["耳机", "Sennheiser HD650 + Logitech G933"],
  ["路由", "Phicomm K3C"],
] as const;

const deskMobile = [
  ["笔记本", "MacBook Air M5 24G+1T"],
  ["显示", "Aoc U32N3C"],
  ["键盘", "NIZ T-35g C103 / IKBC Poker Pro 61"],
  ["鼠标", "Logitech Master 3 / MX Vertical"],
  ["耳机", "Bose QC35 II"],
  ["阅读", "Kindle Paperwhite 4"],
] as const;

const deskGroups = [
  { title: "桌面", items: deskDesktop },
  { title: "移动", items: deskMobile },
];
---

<BaseLayout
  title="About"
  description="Kakarrot 的经历、做事原则与常用设备"
  canonical="/about/"
>
  <div class="container section page-shell editorial-page">
    <header class="editorial-header">
      <h1 class="editorial-title">About</h1>
    </header>

    <section class="about-section">
      <h2>Timeline</h2>
      <dl class="about-timeline">
        <dt>2022 起</dt>
        <dd>开始学习和研究 AI。</dd>
        <dt><time datetime="2026-05">2026.05</time></dt>
        <dd>做出<a href="/vibe-coding/wukong/">悟空</a>，一个在 Mac 上运行的个人智能体。</dd>
        <dt><time datetime="2026-07">2026.07</time></dt>
        <dd>把个人站<a href="/writing/从hexo迁移到astro的心路历程/">从 Hexo 迁到 Astro</a>。</dd>
        <dt><time datetime="2026-07">2026.07</time></dt>
        <dd>发布 <a href="/vibe-coding/claude-cream/">Claude Cream</a>，给编辑器、写作工具和个人站统一配色。</dd>
      </dl>
    </section>

    <section class="about-section">
      <h2>Principles</h2>
      <ul class="about-principles">
        <li>先理解问题，再设计方案。</li>
        <li>技术是手段，不是目的。</li>
        <li>最好的产品是那些用户感觉不到的产品。</li>
      </ul>
    </section>

    <details class="about-section about-kit">
      <summary>Desk &amp; kit</summary>
      <div class="about-desk">
        {
          deskGroups.map(({ title, items }) => (
            <div>
              <h3>{title}</h3>
              <ul>
                {items.map(([label, model]) => (
                  <li><strong>{label}</strong> {model}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</BaseLayout>

<style>
  .about-section + .about-section {
    margin-top: 36px;
  }

  .about-section {
    border-top: var(--line-hairline);
    padding-top: 16px;
    color: var(--color-body);
    line-height: var(--lh-reading);
  }

  .about-section :is(h2, h3, strong, summary) {
    color: var(--color-ink);
    font-weight: 500;
  }

  .about-section h2 {
    margin: 0 0 14px;
    font-size: var(--text-section);
    line-height: 1.6;
  }

  .about-timeline {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 8px 20px;
    margin: 0;
  }

  .about-timeline dt {
    color: var(--color-muted);
    font: 400 var(--text-meta)/1.6 var(--font-mono);
  }

  .about-timeline dd {
    margin: 0;
  }

  .about-timeline a {
    text-decoration-line: underline;
  }

  .about-principles {
    margin: 0;
    padding-left: 1.2rem;
    list-style: disc;
  }

  .about-principles li + li {
    margin-top: 4px;
  }

  .about-principles li::marker {
    color: var(--color-muted);
  }

  .about-kit {
    padding-top: 8px;
  }

  .about-kit summary {
    min-height: 44px;
    align-content: center;
    cursor: pointer;
    font-size: var(--text-section);
    line-height: 1.6;
  }

  .about-kit summary::marker {
    color: var(--color-muted);
    font-size: var(--text-meta);
  }

  .about-desk {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 12px;
  }

  .about-desk h3 {
    margin: 0 0 12px;
    font-size: var(--text-subheading);
  }

  .about-desk ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-meta);
  }

  .about-desk li {
    overflow-wrap: anywhere;
  }

  .about-desk li + li {
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .about-desk {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
