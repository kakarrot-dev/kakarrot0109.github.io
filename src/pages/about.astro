---
import BaseLayout from "@/layouts/BaseLayout.astro";

const personaTags = ["PM", "郑州", "暴雪粉", "音乐狂", "收集癖", "强迫症"];

const deskDesktop = [
  ["CPU", "Intel i5-13600kf"],
  ["主板", "Asus TUF B760M-PLUS WIFI II"],
  ["显卡", "Asus TUF RTX 4070 SUPER O12G"],
  ["内存", "Corsair 16G×2 DDR5 6400"],
  ["固态", "Samsung 980PRO 1T + TiPlus7100 2TB"],
  ["散热", "DeepCool AK620"],
  ["电源", "Phanteks AMP GH850W"],
  ["机箱", "NZXT S340 Elite"],
  ["解码", "OCTAVART Champs-élysées + HD650"],
  ["音箱", "Bose C50"],
  ["键盘", "Filco 圣手二代 104 / Cherry G80-3000"],
  ["鼠标", "Logitech G903 + Master 3"],
  ["显示", "LG 34UC88-B + LG 27GR84Q-B"],
  ["耳机", "Sennheiser HD650 + Logitech G933"],
  ["路由", "Phicomm K3C"],
] as const;

const deskMobile = [
  ["笔记本", "MacBook Air M5 24G+1T"],
  ["显示", "Aoc U32N3C"],
  ["键盘", "NIZ T-35g C103 / IKBC Poker Pro 61"],
  ["鼠标", "Logitech Master 3 / MX Vertical"],
  ["耳机", "Bose QC35 II"],
  ["阅读", "Kindle Paperwhite 4"],
] as const;
---

<BaseLayout title="About" description="AI 产品经理 · 从第一性原理做可落地的产品" canonical="/about/">
  <div class="container section page-shell">
    <header class="page-header">
      <div class="about-header__row">
        <div class="about-header__text">
          <h1 class="page-title">Kakarrot</h1>
          <p class="page-lead">AI 产品经理 · 从第一性原理做可落地的产品</p>
          <div class="prose-header__tags about-header__tags">
            {personaTags.map((tag) => <span class="prose-tag">{tag}</span>)}
          </div>
        </div>
        <img
          class="about-avatar"
          src="/avatar.png"
          alt="Kakarrot"
          width="120"
          height="120"
          decoding="async"
        />
      </div>
    </header>

    <div class="about-content">
      <p>
        大家好，我是 Kakarrot，一名拥有 <strong>10 年+经验</strong> 的产品经理。履历涵盖互联网产品、To
        B 产品、To C 产品， To G 产品，Web 产品、移动产品、桌面产品，熟悉 0→1 创业与 1→∞ 迭代。
      </p>
      <p>
        我擅长从第一性原理识别业务真正的问题，用 AI
        原生方式重新设计产品与增长系统。当前也在整理全新的工作流——结合 AI
        技术与直觉洞察，加速开发并激发协作。
      </p>

      <h2>Timeline</h2>
      <p><strong>2020 前</strong> — 积累做事方法与阅读写作习惯。</p>
      <p><strong>2020 后</strong> — 系统梳理产品专业知识。</p>
      <p><strong>2022 后</strong> — 认识、拥抱、学习、研究 AI。</p>

      <h2>Principles</h2>
      <ul class="about-principles">
        <li>先理解问题，再设计方案。</li>
        <li>技术是手段，不是目的。</li>
        <li>最好的产品是那些用户感觉不到的产品。</li>
      </ul>

      <details class="about-kit" open>
        <summary>Desk &amp; kit</summary>
        <div class="about-desk">
          <div>
            <h3>桌面</h3>
            <ul>
              {
                deskDesktop.map(([k, v]) => (
                  <li>
                    <strong>{k}</strong> {v}
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3>移动</h3>
            <ul>
              {
                deskMobile.map(([k, v]) => (
                  <li>
                    <strong>{k}</strong> {v}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </details>
    </div>
  </div>
</BaseLayout>

<style>
  .about-header__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .about-header__row .page-title {
    margin-bottom: 0;
  }

  .about-header__text {
    min-width: 0;
  }

  .about-header__tags {
    margin-top: 14px;
  }

  .about-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-hairline);
    flex-shrink: 0;
  }

  .about-content {
    font-size: var(--text-body);
    line-height: var(--lh-body);
    color: var(--color-body);
  }

  .about-content p {
    margin: 0 0 16px;
  }

  .about-content strong,
  .about-content h2,
  .about-content h3 {
    color: var(--color-ink);
  }

  .about-content h2 {
    margin: 40px 0 16px;
    font-size: var(--text-section);
    font-weight: 600;
    line-height: var(--lh-title);
  }

  .about-principles {
    margin: 0;
    padding-left: 1.2rem;
    list-style: disc;
  }

  .about-kit {
    margin-top: 40px;
    border-top: 1px solid var(--color-hairline);
    padding-top: 12px;
  }

  .about-kit summary {
    cursor: pointer;
    min-height: 44px;
    align-content: center;
    font: 500 var(--text-meta)/1.5 var(--font-mono);
    color: var(--color-muted);
  }

  .about-desk {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 20px;
    overflow-wrap: anywhere;
  }

  .about-desk h3 {
    margin: 0 0 12px;
    font-size: var(--text-subheading);
    font-weight: 600;
  }

  .about-desk ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 1rem;
  }

  .about-desk li + li {
    margin-top: 6px;
  }

  .about-desk strong {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .about-avatar {
      width: 96px;
      height: 96px;
    }

    .about-desk {
      grid-template-columns: 1fr;
    }
  }
</style>
