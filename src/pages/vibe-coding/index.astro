---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkCard from "@/components/WorkCard.astro";
import { getCollection } from "astro:content";

const orderedSlugs = [
  "wukong",
  "kakarrot-website",
  "claude-cream",
  "obsidian-wiki",
  "pm-ai-agent-book",
  "tampermonkey",
] as const;

const publishedItems = (await getCollection("vibe-coding")).filter(
  (item) => !item.data.draft
);
const itemsBySlug = new Map(publishedItems.map((item) => [item.id, item]));
const ordered = orderedSlugs
  .map((slug) => itemsBySlug.get(slug))
  .filter((item): item is (typeof publishedItems)[number] => !!item);
const rest = publishedItems.filter((item) => !orderedSlugs.includes(item.id as (typeof orderedSlugs)[number]));
const items = [...ordered, ...rest];

const topics = [...new Set(items.flatMap((i) => i.data.topics))];
---

<BaseLayout
  title="Vibe Coding"
  description="从想法到上线：用 AI 协作做出来的工具、站点与实验"
  canonical="/vibe-coding/"
>
  <div class="container section page-shell editorial-page">
    <header class="editorial-header">
      <h1 class="editorial-title">Vibe Coding</h1>
      <div class="editorial-header__details">
        <p class="editorial-lead">从想法到上线：用 AI 协作做出来的工具、站点与实验</p>
        <p class="editorial-count">{items.length} works · {topics.length} topics</p>
      </div>
    </header>

    <ul class="work-list" role="list">
      {
        items.map((work) => (
          <li>
            <WorkCard
              title={work.data.title}
              href={`/vibe-coding/${work.id}/`}
              cover={work.data.cover}
              date={work.data.publishedAt}
              topic={work.data.topics[0]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-list li {
    border-top: var(--line-hairline);
  }

  .work-list li + li {
    margin-top: 36px;
  }
</style>
