---
import ProseLayout from "@/layouts/ProseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("vibe-coding");
  return items
    .filter((p) => !p.data.draft)
    .map((p) => ({
      params: { slug: p.id },
      props: { item: p },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const canonical = `/vibe-coding/${item.id}/`;
---

<ProseLayout
  title={item.data.title}
  description={item.data.description}
  canonical={canonical}
  publishedAt={item.data.publishedAt}
  tags={item.data.topics}
  backHref="/vibe-coding/"
  backLabel="作品"
  product
>
  {
    item.data.cover && (
      <figure slot="hero" class="project-cover border-overlay">
        <img
          src={item.data.cover}
          alt=""
          width="1600"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )
  }
  <Content />
</ProseLayout>
