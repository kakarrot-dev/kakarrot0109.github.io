---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="页面不存在" navigation={false}>
  <section class="shell not-found" aria-labelledby="not-found-title">
    <h1 id="not-found-title">页面不存在</h1>
    <a href="/" class="pill-button interactive pressable">返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 76svh;
    justify-items: center;
    align-content: center;
    gap: 12px;
    text-align: center;
  }

  .not-found h1 {
    margin: 0;
    font-size: inherit;
    font-weight: var(--weight-heading);
  }
</style>
