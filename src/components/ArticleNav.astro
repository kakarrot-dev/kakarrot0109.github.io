---
export interface NavItem {
  title: string;
  href: string;
}

export interface Props {
  prev?: NavItem;
  next?: NavItem;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="article-nav" aria-label="文章导航">
    {prev && (
      <a href={prev.href} class="article-nav-link" data-direction="prev">
        <span class="article-nav-label">上一篇</span>
        <span class="article-nav-title">{prev.title}</span>
        <span class="article-nav-arrow" aria-hidden="true">←</span>
      </a>
    )}
    {next && (
      <a href={next.href} class="article-nav-link" data-direction="next">
        <span class="article-nav-label">下一篇</span>
        <span class="article-nav-title">{next.title}</span>
        <span class="article-nav-arrow" aria-hidden="true">→</span>
      </a>
    )}
  </nav>
)}

<style>
  .article-nav {
    margin-bottom: 8px;
  }

  .article-nav-link {
    display: grid;
    grid-template-columns: 3em minmax(0, 1fr) 1em;
    align-items: baseline;
    gap: 12px;
    min-height: 44px;
    padding-block: 12px;
    color: var(--color-ink);
    font-size: var(--text-subheading);
    line-height: 1.6;
    text-decoration: none;
  }

  .article-nav-link + .article-nav-link {
    border-top: var(--line-hairline);
  }

  .article-nav-label {
    color: var(--color-muted);
    font-size: var(--text-meta);
    white-space: nowrap;
  }

  .article-nav-title {
    overflow-wrap: anywhere;
  }

  .article-nav-arrow {
    color: var(--color-muted);
    text-align: right;
  }

  .article-nav-link:is(:hover, :focus-visible) .article-nav-arrow {
    color: var(--color-primary-text);
  }
</style>
