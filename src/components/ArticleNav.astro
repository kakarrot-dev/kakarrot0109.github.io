---
export interface NavItem {
  title: string;
  href: string;
}

export interface Props {
  prev?: NavItem;
  next?: NavItem;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav
    class="article-nav"
    aria-label="文章导航"
  >
    {prev && (
      <a href={prev.href} class="article-nav-link" data-direction="prev">
        <span class="article-nav-label">← 上一篇</span>
        <span class="article-nav-title">{prev.title}</span>
      </a>
    )}
    {next && (
      <a
        href={next.href}
        class="article-nav-link"
        data-direction="next"
      >
        <span class="article-nav-label">下一篇 →</span>
        <span class="article-nav-title">{next.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-hairline);
  }
  .article-nav-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.5rem;
    padding-block: 0.25rem;
  }
  .article-nav-link[data-direction="next"] {
    grid-column: 2;
    text-align: right;
  }
  .article-nav-label {
    font: 400 var(--text-meta)/1.5 var(--font-mono);
    color: var(--color-muted);
  }
  .article-nav-title {
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.6;
    overflow-wrap: anywhere;
    color: var(--color-ink);
    transition: color var(--dur-fast) ease;
  }
  .article-nav-link:hover .article-nav-title {
    color: var(--color-primary-text);
  }
  @media (max-width: 640px) {
    .article-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-nav-link[data-direction="next"] {
      grid-column: auto;
      text-align: left;
    }
  }
</style>
