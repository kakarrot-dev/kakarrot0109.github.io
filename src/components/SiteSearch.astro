<dialog class="site-search" id="site-search" aria-labelledby="site-search-title">
  <header class="site-search__header">
    <h2 class="sr-only" id="site-search-title">站内搜索</h2>
    <div class="site-search__field">
      <label class="sr-only" for="site-search-input">搜索项目和文章</label>
      <div class="site-search__input-scale">
        <input
          id="site-search-input"
          type="text"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="site-search-results"
          aria-describedby="site-search-keys"
          placeholder="搜索标题、主题或章节"
          autocomplete="off"
          spellcheck="false"
          inputmode="search"
          enterkeyhint="search"
        />
      </div>
    </div>
  </header>
  <form method="dialog" class="site-search__close-form">
    <button type="submit" class="site-search__close interactive pressable" aria-label="关闭搜索">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>
  </form>

  <div class="site-search__scroll">
    <p class="site-search__message" data-search-status role="status"></p>
    <button type="button" class="site-search__action interactive" data-search-retry hidden>重试</button>
    <button type="button" class="site-search__action interactive" data-search-clear hidden>清除关键词</button>
    <div id="site-search-results" role="listbox" aria-label="搜索结果" hidden></div>
  </div>

  <footer class="site-search__keys" id="site-search-keys">
    <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
    <span><kbd>↵</kbd> 确认</span>
    <span><kbd class="site-search__esc">esc</kbd> 关闭</span>
  </footer>
</dialog>

<script>
  import type { SearchEntry } from "../pages/search.json.ts";

  const dialog = document.querySelector<HTMLDialogElement>("#site-search")!;
  const input = dialog.querySelector<HTMLInputElement>("#site-search-input")!;
  const results = dialog.querySelector<HTMLElement>("#site-search-results")!;
  const status = dialog.querySelector<HTMLElement>("[data-search-status]")!;
  const close = dialog.querySelector<HTMLButtonElement>(".site-search__close")!;
  const retry = dialog.querySelector<HTMLButtonElement>("[data-search-retry]")!;
  const clear = dialog.querySelector<HTMLButtonElement>("[data-search-clear]")!;
  const scrollArea = dialog.querySelector<HTMLElement>(".site-search__scroll")!;
  const groups = { "vibe-coding": "Vibe Coding", writing: "Writing" } as const;

  type SearchResult = Pick<SearchEntry, "title" | "href" | "summary" | "group"> & {
    keywords?: string[];
  };

  function normalize(value: string) {
    return value.normalize("NFKC").trim().toLowerCase();
  }

  function findResults(entries: SearchEntry[], query: string) {
    if (!query) return entries;

    const terms = query.split(/\s+/);
    const matches: (SearchResult & { rank: number })[] = [];
    for (const entry of entries) {
      const title = normalize(entry.title);
      const metadata = normalize(`${entry.summary} ${entry.keywords.join(" ")}`);
      if (terms.every((term) => title.includes(term))) {
        matches.push({ ...entry, rank: title.includes(query) ? 4 : 3 });
      } else if (terms.every((term) => title.includes(term) || metadata.includes(term))) {
        matches.push({ ...entry, rank: 1 });
      }

      for (const section of entry.sections) {
        const label = normalize(section.title);
        if (terms.some((term) => label.includes(term)) &&
            terms.every((term) => label.includes(term) || title.includes(term))) {
          matches.push({
            title: section.title,
            summary: entry.title,
            href: `${entry.href}#${encodeURIComponent(section.slug)}`,
            group: entry.group,
            rank: 2,
          });
        }
      }
    }

    return matches.sort((a, b) => b.rank - a.rank);
  }

  let entries: SearchEntry[] | undefined;
  let loading = false;
  let restoreFocus: HTMLElement | undefined;
  let options: HTMLElement[] = [];
  let active = -1;

  function setActive(index: number, scroll = false) {
    const previous = options[active];
    if (previous) {
      previous.setAttribute("aria-selected", "false");
      previous.dataset.selected = "false";
    }
    active = index;
    const option = options[index];
    if (option) {
      option.setAttribute("aria-selected", "true");
      option.dataset.selected = "true";
      input.setAttribute("aria-activedescendant", option.id);
      if (scroll) option.scrollIntoView({ block: "nearest" });
    } else {
      input.removeAttribute("aria-activedescendant");
    }
  }

  function renderResults() {
    if (!entries) return;

    const query = normalize(input.value);
    const matches = findResults(entries, query);
    const groupOrder = query
      ? new Set(matches.map(({ group }) => group))
      : (Object.keys(groups) as SearchEntry["group"][]);
    const fragment = document.createDocumentFragment();
    options = [];
    active = -1;
    for (const group of groupOrder) {
      const items = matches.filter((item) => item.group === group).slice(0, query ? 6 : 3);
      if (!items.length) continue;

      const container = document.createElement("div");
      container.setAttribute("role", "group");
      container.setAttribute("aria-label", groups[group]);
      const label = document.createElement("p");
      label.className = "site-search__label";
      label.setAttribute("aria-hidden", "true");
      label.textContent = groups[group];
      container.append(label);

      for (const item of items) {
        const option = document.createElement("div");
        option.id = `site-search-option-${options.length}`;
        option.className = "site-search__option";
        option.dataset.href = item.href;
        option.dataset.selected = "false";
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");

        const title = document.createElement("span");
        title.className = "site-search__result-title";
        title.textContent = item.title;
        title.title = item.title;
        option.append(title);

        const context = item.href.includes("#")
          ? item.summary
          : item.group === "vibe-coding" ? item.keywords?.[0] : undefined;
        if (context) {
          const note = document.createElement("small");
          note.className = query ? "site-search__detail" : "site-search__detail site-search__default-topic";
          note.textContent = context;
          option.append(note);
        }
        container.append(option);
        options.push(option);
      }
      fragment.append(container);
    }

    results.replaceChildren(fragment);
    results.parentElement?.scrollTo(0, 0);
    results.hidden = !options.length;
    clear.hidden = !query || !results.hidden;
    input.setAttribute("aria-expanded", String(!results.hidden));
    status.classList.toggle("sr-only", !results.hidden);
    status.textContent = results.hidden ? "没有匹配的结果，试试更短的关键词。" : `显示 ${options.length} 条结果。`;
    setActive(results.hidden ? -1 : 0);
  }

  async function loadIndex() {
    if (entries) {
      renderResults();
      return;
    }
    if (loading) return;
    loading = true;
    retry.hidden = true;
    clear.hidden = true;
    status.classList.remove("sr-only");
    status.textContent = "正在加载搜索…";

    try {
      const response = await fetch("/search.json");
      if (!response.ok) throw new Error("Search index request failed");
      const index: SearchEntry[] = await response.json();
      if (!Array.isArray(index)) throw new Error("Search index format is invalid");
      entries = index;
      renderResults();
    } catch {
      entries = undefined;
      status.textContent = "搜索暂时无法加载。";
      retry.hidden = false;
    } finally {
      loading = false;
    }
  }

  function findVisibleControl(selector: string) {
    return [...document.querySelectorAll<HTMLElement>(selector)].find((control) =>
      !control.closest("details:not([open])") && control.getClientRects().length > 0 &&
      getComputedStyle(control).visibility === "visible");
  }

  function openSearch(trigger?: HTMLElement) {
    if (dialog.open) {
      input.focus();
      return;
    }
    restoreFocus = trigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : undefined);
    if (!restoreFocus || restoreFocus === document.body) {
      restoreFocus = findVisibleControl("[data-site-search-open]") ??
        findVisibleControl("[data-site-search-fallback]");
    }
    input.value = "";
    dialog.showModal();
    input.focus();
    void loadIndex();
  }

  function openResult(option?: HTMLElement) {
    if (!option?.dataset.href) return;
    const target = new URL(option.dataset.href, window.location.origin);
    if (target.origin === window.location.origin) {
      restoreFocus = undefined;
      dialog.close();
      window.location.assign(target.href);
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-site-search-open]").forEach((trigger) => {
    trigger.addEventListener("click", () => openSearch(trigger));
  });

  if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
    const modifier = document.querySelector<HTMLElement>("[data-site-search-modifier]");
    if (modifier) {
      modifier.textContent = "⌘";
      modifier.parentElement?.setAttribute("title", "⌘ + K");
    }
  }

  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.isComposing || !(event.metaKey || event.ctrlKey) ||
        event.altKey || event.shiftKey || event.key.toLowerCase() !== "k") return;
    event.preventDefault();
    openSearch();
  });

  dialog.addEventListener("close", () => {
    if (restoreFocus?.isConnected) restoreFocus.focus({ preventScroll: true });
  });

  dialog.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    const lastControl = [clear, retry].find((button) => !button.hidden) ?? close;
    if (event.shiftKey && document.activeElement === input) {
      event.preventDefault();
      lastControl.focus();
    } else if (!event.shiftKey && document.activeElement === lastControl) {
      event.preventDefault();
      input.focus();
    }
  });

  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right ||
        event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
  });

  input.addEventListener("input", (event) => {
    if (!(event instanceof InputEvent && event.isComposing)) renderResults();
  });
  input.addEventListener("compositionend", renderResults);
  input.addEventListener("keydown", (event) => {
    if (event.isComposing || !options.length) return;
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      const delta = event.key === "ArrowDown" ? 1 : -1;
      setActive((active + delta + options.length) % options.length, true);
    } else if (event.key === "Enter") {
      event.preventDefault();
      openResult(options[active]);
    }
  });

  retry.addEventListener("click", () => {
    input.focus();
    void loadIndex();
  });

  clear.addEventListener("click", () => {
    input.value = "";
    input.focus();
    renderResults();
  });

  let scrollbarTimer: ReturnType<typeof setTimeout>;
  scrollArea.addEventListener("scroll", () => {
    scrollArea.dataset.scrolling = "";
    clearTimeout(scrollbarTimer);
    scrollbarTimer = setTimeout(() => delete scrollArea.dataset.scrolling, 100);
  }, { passive: true });

  results.addEventListener("click", (event) => {
    if (event.target instanceof Element) {
      openResult(event.target.closest<HTMLElement>("[role=option]") ?? undefined);
    }
  });

  results.addEventListener("pointermove", (event) => {
    if (event.pointerType !== "mouse" || !(event.target instanceof Element)) return;
    const option = event.target.closest<HTMLElement>("[role=option]");
    if (option && option.dataset.selected !== "true") setActive(options.indexOf(option));
  });
</script>

<style>
  :global(html:has(.site-search[open])) {
    overflow: hidden;
  }

  .site-search {
    position: fixed;
    inset: 18% 0 auto;
    z-index: 50;
    width: calc(100vw - 40px);
    max-width: 720px;
    max-height: calc(82dvh - 20px);
    margin: 0 auto;
    padding: 0;
    overflow: clip;
    border: 0;
    border-radius: var(--radius-2xl);
    background: var(--color-command-surface);
    color: var(--color-gray-1200);
    box-shadow: var(--shadow-custom);
    transition: scale 150ms ease-out, opacity 150ms ease-out;
  }

  .site-search[open] {
    display: flex;
    flex-direction: column;
  }

  .site-search::backdrop {
    background: var(--color-backdrop);
  }

  .site-search__header {
    flex: none;
    padding: 6px 6px 0;
  }

  .site-search__field {
    display: flex;
    align-items: center;
    height: 40px;
    padding-inline: 10px;
    border: 1px solid var(--color-gray-400);
    border-radius: var(--radius-command-item);
    background: var(--color-gray-100);
  }

  .site-search__field:has(input:focus-visible) {
    outline: 2px solid var(--color-gray-1100);
    outline-offset: 2px;
  }

  .site-search__input-scale {
    flex: 1;
    min-width: 0;
    height: 100%;
  }

  .site-search__field input {
    width: calc(100% / 0.875);
    height: 100%;
    padding: 0;
    border: 0;
    transform-origin: left center;
    transform: scale(0.875);
    outline: none;
    background: transparent;
    color: var(--color-gray-1200);
    font-size: 16px;
    line-height: calc(1.25 / 0.875);
  }

  .site-search__field input::placeholder {
    color: var(--color-gray-1100);
    opacity: 1;
  }

  .site-search__close-form {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-end: 6px;
  }

  .site-search__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-command-item);
    color: var(--color-gray-1100);
    cursor: pointer;
  }

  .site-search__close:focus-visible {
    outline-offset: -4px;
  }

  .site-search__scroll {
    min-height: 0;
    max-height: 372px;
    padding: 6px;
    overflow: auto;
    overscroll-behavior: contain;
    scroll-padding-block: 6px;
  }

  .site-search__scroll::-webkit-scrollbar {
    width: 6px;
  }

  .site-search__scroll::-webkit-scrollbar-thumb {
    border-radius: var(--radius-full);
    background-color: transparent;
    transition: background-color 100ms ease-out;
  }

  .site-search__scroll:is(:hover, [data-scrolling])::-webkit-scrollbar-thumb {
    background-color: var(--color-gray-800);
  }

  @supports not selector(::-webkit-scrollbar) {
    .site-search__scroll {
      scrollbar-width: thin;
      scrollbar-color: transparent transparent;
    }

    .site-search__scroll:is(:hover, [data-scrolling]) {
      scrollbar-color: var(--color-gray-800) transparent;
    }
  }

  .site-search__message {
    margin: 10px;
    color: var(--color-gray-1100);
    font-size: 14px;
    line-height: 20px;
  }

  .site-search__action {
    margin: 0 10px 10px;
    padding: 0;
    color: var(--color-gray-1200);
    font-size: 14px;
    line-height: 20px;
    text-decoration: underline var(--color-gray-1100);
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .site-search :global(.site-search__label) {
    margin: 0;
    padding: 10px;
    color: var(--color-gray-900);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .site-search :global([role="group"]:first-child .site-search__label) {
    padding-block-start: 4px;
  }

  .site-search :global(.site-search__option) {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding-inline: 10px;
    border-radius: var(--radius-command-item);
    color: var(--color-gray-1200);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    cursor: pointer;
  }

  .site-search :global(:is(.site-search__result-title, .site-search__detail)) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-search :global(.site-search__detail) {
    max-width: 40%;
    color: var(--color-gray-1100);
    font-size: inherit;
  }

  .site-search :global(.site-search__option[data-selected="true"]) {
    background: var(--color-gray-300);
  }

  .site-search :global(.site-search__option)::after {
    flex: none;
    margin-inline-start: auto;
    width: 6px;
    height: 6px;
    border-block-start: 1px solid currentColor;
    border-inline-end: 1px solid currentColor;
    transform: rotate(45deg);
    opacity: 0;
    content: "";
  }

  .site-search :global(.site-search__option[data-selected="true"])::after {
    opacity: 1;
  }

  @media (forced-colors: active) {
    .site-search {
      outline: 1px solid CanvasText;
    }

    .site-search :global(.site-search__option[data-selected="true"]) {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .site-search__close:hover {
      color: var(--color-gray-1200);
    }
  }

  .site-search__keys {
    display: none;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    height: 45px;
    padding-inline: 14px;
    border-top: 1px solid var(--color-gray-300);
    background: var(--color-command-footer);
    color: var(--color-gray-900);
    font-size: 14px;
    line-height: 20px;
  }

  .site-search__keys span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .site-search__keys kbd {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    border: 1px solid var(--color-gray-400);
    border-radius: var(--radius-md);
    background: var(--color-preview-bg);
    color: var(--color-gray-1100);
    font: 450 14px/1 var(--font-sans);
  }

  .site-search__keys .site-search__esc {
    padding-inline: 6px;
    font-size: 12px;
  }

  @media (width < 40rem) {
    .site-search__field {
      padding-inline-end: 42px;
    }

    .site-search :global(.site-search__default-topic) {
      display: none;
    }
  }

  @media (min-width: 40rem) {
    .site-search__field input {
      width: 100%;
      transform: none;
      font-size: 14px;
      line-height: 20px;
    }

    .site-search__close-form {
      inset: auto auto 2px 6px;
    }

    .site-search__keys {
      display: flex;
    }
  }

  @media (prefers-contrast: more) {
    .site-search :global(.site-search__label),
    .site-search__keys {
      color: var(--color-gray-1100);
    }
  }
</style>
