---
/** 主题切换：写入 localStorage，同步 html[data-theme] */
---

<button
  type="button"
  class="theme-toggle"
  aria-label="切换到深色模式"
  aria-pressed="false"
  data-theme-toggle
>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
  </svg>
</button>

<script>
  function syncThemeButton(btn: Element, theme: "light" | "dark") {
    const isDark = theme === "dark";
    const label = isDark ? "切换到浅色模式" : "切换到深色模式";
    btn.setAttribute("aria-label", label);
    btn.setAttribute("aria-pressed", String(isDark));
    btn.setAttribute("title", label);
  }

  const button = document.querySelector("[data-theme-toggle]");
  if (button) {
    let hasManualTheme = false;
    try {
      const stored = localStorage.getItem("theme");
      hasManualTheme = stored === "light" || stored === "dark";
    } catch {
      /* ignore */
    }

    const applyTheme = (theme: "light" | "dark") => {
      document.documentElement.setAttribute("data-theme", theme);
      syncThemeButton(button, theme);
    };

    const initial = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
    syncThemeButton(button, initial);
    button.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
      const next = current === "dark" ? "light" : "dark";
      hasManualTheme = true;
      applyTheme(next);
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* ignore */
      }
    });
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", ({ matches }) => {
      if (!hasManualTheme) applyTheme(matches ? "dark" : "light");
    });
  }
</script>
