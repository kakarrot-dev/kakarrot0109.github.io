---
export interface Props {
  title: string;
  href: string;
  date?: Date;
  meta?: string;
  groupedByYear?: boolean;
  compact?: boolean;
}

const { title, href, date, meta, groupedByYear = false, compact = false } = Astro.props;
const Title = groupedByYear ? "span" : compact ? "h3" : "h2";
const numberedTitle = compact ? title.match(/^(No\. \d+:) (.+)$/) : null;

const isoDate = date?.toISOString().slice(0, 10);
const dateLabel = isoDate
  ? (groupedByYear ? isoDate.slice(5) : isoDate).replace(/-/g, ".")
  : meta;
---

<a href={href} class="article-row">
  <span class="article-row__mark" aria-hidden="true">
    <svg viewBox="0 0 32 36" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" focusable="false">
      <path d="M6 8h15M6 14h18M6 20h10" />
    </svg>
  </span>
  <Title class="article-row__title">
    {numberedTitle ? (
      <><span class="sr-only">{numberedTitle[1]}</span>{" "}{numberedTitle[2]}</>
    ) : title}<span class="row-arrow" aria-hidden="true"></span>
  </Title>
  {isoDate
    ? <time class="article-row__meta" datetime={isoDate}>{dateLabel}</time>
    : dateLabel && <span class="article-row__meta">{dateLabel}</span>}
</a>

<style>
  .article-row {
    --article-folio: 64px;
    position: relative;
    display: block;
    min-height: 78px;
    padding-block: 14px;
    padding-inline-start: var(--article-folio);
    color: inherit;
    font: 400 17px/1.625 var(--font-sans);
    text-decoration: none;
  }

  .article-row__title {
    display: block;
    margin: 0;
    color: var(--color-ink);
    font-weight: 450;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .article-row__mark {
    position: absolute;
    inset-block-start: 17px;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 48px;
    border: var(--line-hairline);
    border-radius: 8px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-edge);
    color: color-mix(in oklab, var(--color-muted) 17%, var(--color-hairline));
  }

  .article-row__mark svg {
    width: 34px;
    height: 38px;
    border: var(--line-divider);
    border-radius: 5px;
    background: var(--color-surface);
  }

  .article-row__meta {
    display: block;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .article-row {
      --article-folio: 56px;
    }
  }
</style>
