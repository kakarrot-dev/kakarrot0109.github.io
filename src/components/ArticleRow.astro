---
import IndexRow from "@/components/IndexRow.astro";

export interface Props {
  title: string;
  href: string;
  date?: Date;
  meta?: string;
  groupedByYear?: boolean;
  compact?: boolean;
}

const { title, href, date, meta, groupedByYear = false, compact = false } = Astro.props;
const numberedTitle = compact ? title.match(/^(No\. \d+:) (.+)$/) : null;
const isoDate = date?.toISOString().slice(0, 10);
const dateLabel = isoDate && (groupedByYear ? isoDate.slice(5) : isoDate).replace(/-/g, ".");
---

<IndexRow
  href={href}
  title={numberedTitle?.[2] ?? title}
  titlePrefix={numberedTitle?.[1]}
  date={isoDate && dateLabel ? { iso: isoDate, label: dateLabel } : undefined}
  summary={isoDate ? undefined : meta}
  heading={!groupedByYear && !compact}
/>
