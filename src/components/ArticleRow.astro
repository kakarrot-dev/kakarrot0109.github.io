---
export interface Props {
  title: string;
  href: string;
  date?: Date;
  meta?: string;
  groupedByYear?: boolean;
}

const { title, href, date, meta, groupedByYear = false } = Astro.props;
const Title = groupedByYear ? "span" : "h2";

const isoDate = date?.toISOString().slice(0, 10);
const dateLabel = isoDate
  ? (groupedByYear ? isoDate.slice(5) : isoDate).replace(/-/g, ".")
  : meta;
---

<a href={href} class="article-row">
  <Title class="article-row__title">{title}</Title>
  {dateLabel ? <time class="article-row__meta" datetime={isoDate}>{dateLabel}</time> : null}
</a>
