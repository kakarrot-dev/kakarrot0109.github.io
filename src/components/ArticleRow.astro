---
export interface Props {
  title: string;
  href: string;
  date?: Date;
  meta?: string;
  groupedByYear?: boolean;
}

const { title, href, date, meta, groupedByYear = false } = Astro.props;
const Title = groupedByYear ? "span" : "h2";
const numberedTitle = groupedByYear ? title.match(/^(No\. \d+:) (.+)$/) : null;

const isoDate = date?.toISOString().slice(0, 10);
const dateLabel = isoDate
  ? (groupedByYear ? isoDate.slice(5) : isoDate).replace(/-/g, ".")
  : meta;
---

<a href={href} class:list={["article-row", groupedByYear && "article-row--grouped"]}>
  <Title class="article-row__title">
    {numberedTitle ? (
      <><span class="article-row__issue">{numberedTitle[1]}</span>{" "}{numberedTitle[2]}</>
    ) : title}
  </Title>
  {dateLabel ? <time class="article-row__meta" datetime={isoDate}>{dateLabel}</time> : null}
</a>

<style>
  .article-row--grouped .article-row__title {
    font-size: var(--text-small);
    line-height: 1.55;
  }

  .article-row__issue {
    font: 400 var(--text-meta)/1 var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .article-row--grouped .article-row__meta {
    font-size: 12px;
    text-align: right;
  }

  @media (max-width: 640px) {
    .article-row--grouped {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
    }
  }
</style>
