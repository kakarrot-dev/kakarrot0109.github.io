---
import IndexRow from "@/components/IndexRow.astro";

export interface Props {
  title: string;
  summary: string;
  href: string;
  cover?: string;
  icon?: string;
  date: Date;
  topic?: string;
  compact?: boolean;
}

const { title, summary, href, cover, icon, date, topic, compact = false } = Astro.props;
const isoDate = date.toISOString().slice(0, 10);
---

<IndexRow
  href={href}
  title={title}
  summary={summary}
  icon={icon ?? cover}
  date={compact ? undefined : { iso: isoDate, label: isoDate.replace(/-/g, "."), topic }}
  heading={!compact}
/>
