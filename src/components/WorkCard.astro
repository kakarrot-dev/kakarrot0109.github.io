---
export interface Props {
  title: string;
  href: string;
  cover?: string;
  meta?: string;
  class?: string;
}

const {
  title,
  href,
  cover,
  meta,
  class: className = "",
} = Astro.props;
---

<a href={href} class:list={["work-card", className]}>
  <div class="work-card__body">
    {meta ? <p class="work-card__meta">{meta}</p> : null}
    <h2 class="work-card__title">{title}</h2>
  </div>
  {
    cover && (
      <div class="work-card__media">
        <img
          src={cover}
          alt=""
          width="320"
          height="200"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</a>
