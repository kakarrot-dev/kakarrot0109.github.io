---
export interface Props {
  title: string;
  summary: string;
  href: string;
  cover?: string;
  date: Date;
  topic?: string;
}

const { title, summary, href, cover, date, topic } = Astro.props;
const isoDate = date.toISOString().slice(0, 10);
---

<a href={href} class:list={["work-card", cover && "work-card--with-cover"]}>
  <div class="work-card__body">
    <h2 class="work-card__title">{title}</h2>
    <p class="work-card__summary">{summary}</p>
    <p class="work-card__meta">
      <time datetime={isoDate}>{isoDate.replace(/-/g, ".")}</time>{topic ? ` · ${topic}` : ""}
    </p>
  </div>
  {
    cover && (
      <div class="work-card__media">
        <img
          src={cover}
          alt=""
          width="320"
          height="200"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</a>

<style>
  .work-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 20px;
    padding-block: 16px;
    text-decoration: none;
    color: inherit;
  }

  .work-card--with-cover {
    grid-template-columns: minmax(0, 1fr) 160px;
  }

  .work-card__title {
    margin: 0;
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .work-card:is(:hover, :focus-visible) .work-card__title {
    color: var(--color-primary-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .work-card__summary {
    margin: 4px 0 0;
    color: var(--color-body);
    font-size: var(--text-subheading);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .work-card__meta {
    margin: 4px 0 0;
    font: 400 var(--text-meta)/1.6 var(--font-mono);
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .work-card__meta time {
    white-space: nowrap;
  }

  .work-card__media {
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
  }

  .work-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .work-card {
      gap: 12px;
      align-items: start;
    }

    .work-card--with-cover {
      grid-template-columns: minmax(0, 1fr) 88px;
    }
  }
</style>
