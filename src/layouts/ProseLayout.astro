---
import BaseLayout from "@/layouts/BaseLayout.astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
  product?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = "article",
  publishedAt,
  updatedAt,
  tags = [],
  backHref,
  backLabel,
  product = false,
} = Astro.props;
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {ogType}
  {publishedAt}
  {updatedAt}
  {tags}
  navigation={false}
  reading
>
  <div class="shell main-full">
    <header class="reading-toolbar">
      <a href={backHref} class="icon-button interactive pressable" aria-label={`返回${backLabel}`} data-tooltip={`返回${backLabel}`} data-site-search-fallback>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="m10.5 6.3-5.4 5.4 5.4 5.4m-5.4-5.4h7.8a5.4 5.4 0 0 1 5.4 5.4" />
        </svg>
      </a>
      <button type="button" class="icon-button interactive pressable" aria-label="复制永久链接" data-tooltip="复制永久链接" data-copy-permalink hidden>
        <span class="copy-mark" data-permalink-icon aria-hidden="true"></span>
      </button>
      <p class="reading-copy-status sr-only" role="status" aria-live="polite" data-permalink-status></p>
    </header>

    <main class="reading-main article-body">
      {product ? (
        <header class="product-hero">
          <h1><span aria-hidden="true">/</span> {title}</h1>
          {description && <p>{description}</p>}
        </header>
      ) : <h1 class="article-title">{title}</h1>}
      <div class="prose prose-body">
        <slot name="hero" />
        <slot />
      </div>
      <slot name="end" />
    </main>
  </div>
</BaseLayout>

<style>
  .reading-toolbar {
    position: relative;
    display: flex;
    min-block-size: calc(var(--spacing) * 9);
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 2);
    user-select: none;
  }

  .reading-toolbar :global(svg) {
    display: block;
    inline-size: 18px;
    block-size: 18px;
  }

  .reading-toolbar .copy-mark {
    display: block;
  }

  .reading-toolbar .icon-button {
    position: relative;
  }

  .reading-toolbar [data-tooltip]::after {
    position: absolute;
    inset-block-start: calc(100% + var(--spacing) * 2);
    inset-inline-start: 0;
    z-index: 50;
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2.5);
    border-radius: var(--radius-lg);
    background: var(--color-preview-bg);
    color: var(--color-gray-1200);
    box-shadow: var(--shadow-custom);
    content: attr(data-tooltip);
    font-size: var(--text-sm);
    line-height: calc(var(--spacing) * 5);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  .reading-toolbar button[data-tooltip]::after {
    inset-inline: auto 0;
  }

  .reading-toolbar [data-tooltip]:focus-visible::after {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .reading-toolbar [data-tooltip]:hover::after {
      opacity: 1;
    }
  }

  .reading-copy-status:not(.sr-only) {
    position: absolute;
    inset-block-start: calc(100% + var(--spacing) * 2);
    inset-inline-end: 0;
    z-index: 50;
    margin: 0;
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2.5);
    border-radius: var(--radius-lg);
    background: var(--color-preview-bg);
    color: var(--color-danger-text);
    box-shadow: var(--shadow-custom);
    font-size: var(--text-sm);
    line-height: calc(var(--spacing) * 5);
    text-align: end;
  }

  .reading-main {
    min-inline-size: 0;
    margin-block-start: calc(var(--spacing) * 24);
  }

  .article-title {
    width: fit-content;
    margin: 0 0 calc(var(--spacing) * 5);
    scroll-margin-block-start: calc(var(--spacing) * 20);
    color: var(--color-gray-1200);
    font-size: var(--text-body);
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  .product-hero {
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
  }

  .product-hero h1 {
    margin: 0 0 calc(var(--spacing) * 4);
    color: var(--color-gray-1200);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: calc(var(--spacing) * 8);
    overflow-wrap: anywhere;
  }

  .product-hero h1 span {
    color: var(--color-gray-900);
  }

  .product-hero p {
    margin: 0;
    color: var(--color-text-paragraph);
    overflow-wrap: anywhere;
  }

  .prose :global(:is(h1, h2, h3)[id]) {
    scroll-margin-block-start: calc(var(--spacing) * 20);
  }
</style>

<script>
    document.querySelectorAll<HTMLHeadingElement>(".prose-body > h2").forEach((heading) => {
      const title = document.createElement("span");
      title.className = "anchor-label";
      title.append(...heading.childNodes);
      if (heading.id) {
        const link = document.createElement("a");
        link.className = "heading-anchor interactive";
        link.href = `#${encodeURIComponent(heading.id)}`;
        link.ariaLabel = `章节链接：${title.textContent?.trim() ?? ""}`;
        link.textContent = "#";
        title.prepend(link);
      }
      const hairline = document.createElement("span");
      hairline.className = "hairline";
      hairline.ariaHidden = "true";
      heading.append(title, hairline);
      heading.classList.add("article-heading");
    });

    document.querySelectorAll(".prose-body > p:not(:has(img)) + p:not(:has(img))").forEach((paragraph) => {
      const gap = document.createElement("div");
      gap.className = "paragraph-break";
      gap.ariaHidden = "true";
      gap.append(document.createElement("br"));
      paragraph.before(gap);
    });

    document.querySelectorAll(".prose-body > blockquote").forEach((quote) => {
      const figure = document.createElement("figure");
      figure.className = "quote-card interactive";
      quote.before(figure);
      figure.append(quote);

      const footer = quote.querySelector(":scope > footer");
      if (footer) {
        const caption = document.createElement("figcaption");
        const credit = document.createElement("div");
        credit.append(...footer.childNodes);
        caption.append(credit);
        figure.append(caption);
        footer.remove();
      }

      const mark = (text: string) => {
        const span = document.createElement("span");
        span.className = "quote-mark";
        span.ariaHidden = "true";
        span.textContent = text;
        return span;
      };
      (quote.querySelector(":scope > p:first-child") ?? quote).prepend(mark("“"));
      (quote.querySelector(":scope > p:last-child") ?? quote).append(mark("”"));
    });

    document.querySelectorAll(".prose-body table").forEach((table) => {
      const block = document.createElement("div");
      block.className = "table-block";
      const scroll = document.createElement("div");
      scroll.className = "table-scroll";
      const hint = document.createElement("p");
      hint.className = "table-scroll-hint";
      hint.textContent = "横向滚动查看完整表格";
      hint.hidden = true;
      hint.setAttribute("aria-hidden", "true");
      table.before(block);
      block.append(hint, scroll);
      scroll.append(table);

      const updateOverflow = () => {
        const overflowing = scroll.scrollWidth > scroll.clientWidth;
        hint.hidden = !overflowing;
        if (overflowing) {
          scroll.tabIndex = 0;
          scroll.setAttribute("role", "region");
          scroll.setAttribute("aria-label", "可横向滚动的表格");
        } else {
          scroll.removeAttribute("tabindex");
          scroll.removeAttribute("role");
          scroll.removeAttribute("aria-label");
        }
      };
      updateOverflow();
      const tableSize = new ResizeObserver(updateOverflow);
      tableSize.observe(scroll);
      tableSize.observe(table);
    });

  document.addEventListener("DOMContentLoaded", () => {
    const permalinkMark = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m10 14 4-4M8.25 17.5l-1 1a3.36 3.36 0 0 1-4.75-4.75l3.75-3.75a3.36 3.36 0 0 1 4.75 0m4.75-3.5 1-1a3.36 3.36 0 0 1 4.75 4.75l-3.75 3.75a3.36 3.36 0 0 1-4.75 0"/></svg>`;
    const copyIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const copiedIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>`;
    const copyFailedIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 6v7m0 5h.01"/></svg>`;
    const permalinkButton = document.querySelector<HTMLButtonElement>("[data-copy-permalink]");
    const permalinkIcon = permalinkButton?.querySelector("[data-permalink-icon]");
    const permalinkStatus = document.querySelector<HTMLElement>("[data-permalink-status]");
    if (permalinkButton && permalinkIcon && permalinkStatus) {
      const permalink = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href
        ?? new URL(location.pathname, location.origin).href;
      let statusTimeout: number | undefined;
      let copying = false;
      permalinkIcon.innerHTML = permalinkMark;
      permalinkButton.hidden = false;
      permalinkButton.addEventListener("click", async (event) => {
        if (copying) return;
        copying = true;
        window.clearTimeout(statusTimeout);
        permalinkStatus.classList.add("sr-only");
        permalinkStatus.textContent = "";
        let copied = false;
        try {
          await navigator.clipboard.writeText(permalink);
          copied = true;
        } catch {
          // 反馈失败状态，仍允许从地址栏手动复制。
        }
        copying = false;
        const message = copied ? "链接已复制" : "复制失败，请从地址栏复制链接";
        permalinkIcon.innerHTML = copied ? copiedIcon : copyFailedIcon;
        if (copied) animateCopyMark(permalinkIcon, event);
        if (copied) permalinkButton.dataset.tooltip = message;
        else delete permalinkButton.dataset.tooltip;
        permalinkStatus.textContent = message;
        permalinkStatus.classList.toggle("sr-only", copied);
        statusTimeout = window.setTimeout(() => {
          permalinkIcon.innerHTML = permalinkMark;
          permalinkButton.dataset.tooltip = "复制永久链接";
          permalinkStatus.classList.add("sr-only");
          permalinkStatus.textContent = "";
        }, 3800);
      });
    }

    // 代码块：文件名、复制和状态反馈
    document.querySelectorAll<HTMLPreElement>(".prose .astro-code").forEach((pre) => {
      if (pre.parentElement?.classList.contains("code-block-wrap")) return;
      const lang = (pre.getAttribute("data-language") || "text").toUpperCase();
      if (lang === "MERMAID") return;

      const wrap = document.createElement("figure");
      wrap.className = "code-block-wrap preview-code";
      pre.tabIndex = 0;

      const header = document.createElement("div");
      header.className = "code-block-header";

      const file = document.createElement("span");
      file.className = "code-file";
      file.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9m-6-6 6 6h-6V3"/></svg>`;
      const fileName = document.createElement("span");
      fileName.textContent = pre.dataset.filename || lang;
      fileName.title = fileName.textContent;
      file.append(fileName);

      const status = document.createElement("span");
      status.className = "code-copy-status sr-only";
      status.setAttribute("role", "status");
      status.setAttribute("aria-live", "polite");

      const copyBtn = document.createElement("button");
      copyBtn.type = "button";
      copyBtn.className = "copy-btn interactive pressable";
      copyBtn.setAttribute("aria-label", "复制代码");
      copyBtn.title = "复制代码";
      const copyMark = document.createElement("span");
      copyMark.className = "copy-mark";
      copyMark.ariaHidden = "true";
      copyMark.innerHTML = copyIcon;
      copyBtn.append(copyMark);

      let copying = false;
      let statusTimeout: number | undefined;
      copyBtn.addEventListener("click", async (event) => {
        if (copying) return;

        copying = true;
        window.clearTimeout(statusTimeout);
        status.classList.add("sr-only");
        status.textContent = "";
        copyMark.innerHTML = copyIcon;

        const code = pre.querySelector("code")?.innerText || pre.innerText;
        let copied = false;
        try {
          await navigator.clipboard.writeText(code);
          copied = true;
        } catch {
          // Clipboard restrictions can prevent writing even when the API exists.
        }
        copying = false;

        copyMark.innerHTML = copied ? copiedIcon : copyFailedIcon;
        if (copied) animateCopyMark(copyMark, event);
        status.textContent = copied ? "代码已复制" : "复制失败，请手动复制";
        status.classList.toggle("sr-only", copied);
        copyBtn.title = status.textContent;
        statusTimeout = window.setTimeout(() => {
          copyMark.innerHTML = copyIcon;
          copyBtn.title = "复制代码";
          status.classList.add("sr-only");
          status.textContent = "";
        }, 3800);
      });

      header.append(file, status, copyBtn);
      wrap.append(header);
      pre.before(wrap);
      wrap.appendChild(pre);
    });

    // Mermaid
    const mermaidBlocks = document.querySelectorAll<HTMLPreElement>('.prose pre[data-language="mermaid"]');
    if (mermaidBlocks.length > 0) {
      void import("mermaid").then(({ default: mermaid }) => {
        const root = document.documentElement;
        const diagrams = Array.from(mermaidBlocks, (pre) => {
          const host = document.createElement("div");
          host.className = "mermaid";
          return { pre, host, source: (pre.querySelector("code")?.textContent ?? pre.textContent ?? "").trim() };
        });
        let renderId = 0;
        let renderedDark: boolean | undefined;
        let rendering = Promise.resolve();
        const canvas = document.createElement("canvas");
        canvas.width = canvas.height = 1;
        const pixel = canvas.getContext("2d", { willReadFrequently: true });

        const refresh = () => {
          rendering = rendering.then(async () => {
            const dark = root.dataset.theme === "dark";
            if (renderedDark === dark) return;

            const styles = getComputedStyle(root);
            const token = (name: string) => styles.getPropertyValue(name).trim();
            const color = (name: string) => {
              const value = token(name);
              // Mermaid 的颜色解析器只接受 sRGB 表示。
              if (!pixel || !value.startsWith("lab(")) return value;
              pixel.fillStyle = value;
              pixel.fillRect(0, 0, 1, 1);
              const [red, green, blue] = pixel.getImageData(0, 0, 1, 1).data;
              return `rgb(${red}, ${green}, ${blue})`;
            };
            const canvasColor = color("--color-canvas");
            const surface = color("--color-surface");
            const ink = color("--color-ink");
            const muted = color("--color-muted");
            const border = color("--color-hairline");
            const accent = color("--color-gray-800");
            const fontFamily = token("--font-sans");

            mermaid.initialize({
              startOnLoad: false,
              suppressErrorRendering: true,
              theme: "base",
              securityLevel: "loose",
              fontFamily,
              xyChart: {
                width: 600,
                height: 360,
                xAxis: { labelFontSize: 15 },
                yAxis: { labelFontSize: 15 },
              },
              themeVariables: {
                darkMode: dark,
                background: canvasColor,
                primaryColor: surface,
                primaryTextColor: ink,
                primaryBorderColor: border,
                secondaryColor: canvasColor,
                tertiaryColor: surface,
                lineColor: muted,
                textColor: ink,
                noteBkgColor: canvasColor,
                noteTextColor: ink,
                noteBorderColor: border,
                edgeLabelBackground: canvasColor,
                xyChart: {
                  backgroundColor: surface,
                  titleColor: ink,
                  xAxisTitleColor: ink,
                  xAxisLabelColor: ink,
                  xAxisLineColor: muted,
                  xAxisTickColor: muted,
                  yAxisTitleColor: ink,
                  yAxisLabelColor: ink,
                  yAxisLineColor: muted,
                  yAxisTickColor: muted,
                  plotColorPalette: `${accent}, ${ink}, ${muted}`,
                },
              },
            });
            renderedDark = dark;

            for (const { pre, host, source } of diagrams) {
              try {
                const { svg } = await mermaid.render(`site-mermaid-${renderId++}`, source);
                host.innerHTML = svg;
                if (pre.isConnected) pre.replaceWith(host);
              } catch (error) {
                if (host.isConnected) host.replaceWith(pre);
                console.error("Mermaid 渲染失败", error);
              }
            }
          }).catch((error) => console.error("Mermaid 初始化失败", error));
        };

        refresh();
        new MutationObserver(refresh).observe(root, { attributeFilter: ["data-theme"] });
      }).catch((error) => {
        console.error("Mermaid 加载失败", error);
      });
    }

  });

  function animateCopyMark(mark: Element, event: MouseEvent) {
    if (event.detail === 0 || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    mark.animate([
      { opacity: 0, filter: "blur(4px)", transform: "translateY(2px)" },
      { opacity: 1, filter: "blur(0)", transform: "translateY(0)" },
    ], { duration: 200, easing: "ease-out" });
  }
</script>
